pkgname=opwall
pkgver=0.1.0
pkgrel=1
pkgdesc='A movie-style operations wall of live panels, all randomized data'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/opwall "$pkgdir/usr/bin/opwall"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/opwall.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/opwall.svg"
  install -Dm644 "$startdir/opwall.desktop" "$pkgdir/usr/share/applications/opwall.desktop"
}
